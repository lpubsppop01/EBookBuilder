<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Lpubsppop01.EBookBuilder.Cli</RootNamespace>
    <!-- The GUI side uses ebookbuilder, so the executable name is kept separate. -->
    <AssemblyName>ebookbuilder-cli</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EBookBuilder.Core\EBookBuilder.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The SkiaSharp native assets are needed per platform.
      Keep the versions in step with the SkiaSharp that EBookBuilder.Core references.
    -->
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.152.0" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.152.0" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>

</Project>
