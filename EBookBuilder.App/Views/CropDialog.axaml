<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Lpubsppop01.EBookBuilder.App.ViewModels"
        x:Class="Lpubsppop01.EBookBuilder.App.Views.CropDialog"
        x:DataType="vm:CropSettings"
        Title="Crop"
        Width="900" Height="600"
        MinWidth="600" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Button">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="8,2"/>
            <!--
                The Fluent theme does not set the horizontal alignment, so set it explicitly
                (the default is Stretch, which means left-aligned).
            -->
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="NumericUpDown">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Increment" Value="1"/>
        </Style>
    </Window.Styles>

    <Grid Margin="6"
          RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
          ColumnDefinitions="Auto,140,Auto,140">

        <TextBlock Grid.Row="0" Grid.Column="0">Top</TextBlock>
        <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding Top}"/>
        <TextBlock Grid.Row="0" Grid.Column="2">Bottom</TextBlock>
        <NumericUpDown Grid.Row="0" Grid.Column="3" Value="{Binding Bottom}"/>

        <TextBlock Grid.Row="1" Grid.Column="0">Left</TextBlock>
        <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Left}"/>
        <TextBlock Grid.Row="1" Grid.Column="2">Right</TextBlock>
        <NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding Right}"/>

        <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal">
            <Button Content="Reset" Click="Reset_Click"/>
            <TextBlock VerticalAlignment="Center">
                <Run Text="Remaining size:"/>
                <Run Text="{Binding CropWidth}"/>
                <Run Text="x"/>
                <Run Text="{Binding CropHeight}"/>
            </TextBlock>
        </StackPanel>

        <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="4">
            The red areas will be cropped away.
        </TextBlock>

        <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="4" Margin="3"
                BorderThickness="1" BorderBrush="Gray"
                ClipToBounds="True">
            <Grid x:Name="ctrlPreviewHost">
                <Image x:Name="ctrlPreviewImage" Source="{Binding PreviewImage}" Stretch="Uniform"/>
                <Canvas x:Name="ctrlMaskCanvas">
                    <Rectangle x:Name="ctrlMaskTop" Fill="#80FF0000"/>
                    <Rectangle x:Name="ctrlMaskBottom" Fill="#80FF0000"/>
                    <Rectangle x:Name="ctrlMaskLeft" Fill="#80FF0000"/>
                    <Rectangle x:Name="ctrlMaskRight" Fill="#80FF0000"/>
                </Canvas>
            </Grid>
        </Border>

        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="4"
                    Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="OK" Click="Ok_Click" IsDefault="True" MinWidth="90"/>
            <Button Content="Cancel" Click="Cancel_Click" IsCancel="True" MinWidth="90"/>
        </StackPanel>
    </Grid>
</Window>
